@model WebApplication2.ViewModels.Class.ClassPageViewModel

@{
    ViewData["Title"] = "Class";
    bool isEdit = Model.Class.Id > 0;
}

<div class="container mt-4">

    <h2>@(isEdit ? "Edit Class" : "Add Class")</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            @TempData["Message"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-controller="Class"
          asp-action="Index"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Class.Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Class.Name"
                   class="form-label">Class Name</label>

            <input asp-for="Class.Name"
                   class="form-control"
                   placeholder="Enter class name" />

            <span asp-validation-for="Class.Name"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            @(isEdit ? "Update Class" : "Add Class")
        </button>

        @if (isEdit)
        {
            <a asp-controller="Class"
               asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>
        }

    </form>

    <hr class="my-4" />

    <h2>Class List</h2>

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Class ID</th>
                    <th>Class Name</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Classes != null && Model.Classes.Any())
                {
                    @foreach (var item in Model.Classes)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Name</td>

                            <td>
                                <a asp-controller="Class"
                                   asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <form asp-controller="Class"
                                      asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-sm"
                                            onclick="return confirm('Are you sure you want to delete this class?');">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center">
                            No classes found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
