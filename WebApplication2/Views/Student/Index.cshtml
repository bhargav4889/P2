@model WebApplication2.ViewModels.Student.StudentPageViewModel

@{
    ViewData["Title"] = "Student Management";
    bool isEdit = Model.Student.Id > 0;
}

<div class="container mt-4">

    <h2>@(isEdit ? "Edit Student" : "Insert Student")</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            @TempData["Message"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-controller="Student"
          asp-action="Index"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Student.Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Student.FirstName"
                   class="form-label"></label>

            <input asp-for="Student.FirstName"
                   class="form-control" />

            <span asp-validation-for="Student.FirstName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Student.LastName"
                   class="form-label"></label>

            <input asp-for="Student.LastName"
                   class="form-control" />

            <span asp-validation-for="Student.LastName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Student.Age"
                   class="form-label"></label>

            <input asp-for="Student.Age"
                   class="form-control" />

            <span asp-validation-for="Student.Age"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Student.Email"
                   class="form-label"></label>

            <input asp-for="Student.Email"
                   class="form-control" />

            <span asp-validation-for="Student.Email"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Student.ClassId" class="form-label">
                Class
            </label>

            <select asp-for="Student.ClassId"
                    class="form-select"
                    asp-items="@(new SelectList(
                                Model.Classes ?? new List<TblClass>(),
                                nameof(TblClass.Id),
                                nameof(TblClass.Name)))">

                <option value="">-- Select Class --</option>
            </select>

            <span asp-validation-for="Student.ClassId"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            @(isEdit ? "Update Student" : "Insert Student")
        </button>

        @if (isEdit)
        {
            <a asp-controller="Student"
               asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>
        }

    </form>

    <hr class="my-4" />

    <h2>Student List</h2>

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Age</th>
                    <th>Email</th>
                    <th>Class Name</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Students != null && Model.Students.Any())
                {
                    @foreach (var student in Model.Students)
                    {
                        <tr>
                            <td>@student.Id</td>
                            <td>@student.FirstName</td>
                            <td>@student.LastName</td>
                            <td>@student.Age</td>
                            <td>@student.Email</td>
                            <td>@student.ClassName</td>

                            <td>
                                <a asp-controller="Student"
                                   asp-action="Edit"
                                   asp-route-id="@student.Id"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <form asp-controller="Student"
                                      asp-action="Delete"
                                      asp-route-id="@student.Id"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-sm"
                                            onclick="return confirm('Are you sure you want to delete this student?');">
                                        Delete
                                    </button>

                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">
                            No students found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
